// Jetons de design neutres et réutilisables : aucune référence au métier PDFMerge.
export global Theme {
    out property <color> bg: #1c1c1c;
    out property <color> panel: #232323;
    out property <color> panel-border: #2f2f2f;
    out property <color> control: #2d2d2d;
    out property <color> control-hover: #363636;
    out property <color> control-border: #3a3a3a;
    out property <color> text: #e8e8e8;
    out property <color> text-muted: #9a9a9a;
    out property <color> accent: #4fc3f7;
    out property <color> on-accent: #0b1d26;
    out property <color> error: #ef5350;
    out property <color> success: #66bb6a;

    out property <length> radius-panel: 8px;
    out property <length> radius-control: 6px;
    out property <length> control-height: 32px;
    out property <length> padding-window: 12px;
    out property <length> padding-panel: 12px;
    out property <length> gap: 12px;
    out property <length> gap-small: 8px;
    out property <length> font-size: 14px;
    out property <length> font-size-title: 16px;
    out property <length> font-size-small: 12px;
}