import { Theme } from "./theme.slint";

// Conteneur générique : titre + contenu. Aucune référence à un métier PDFMerge.
export component Panel inherits Rectangle {
    in property <string> title: "";

    width: 100%;
    border-radius: Theme.radius-panel;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.panel-border;

    VerticalLayout {
        padding: Theme.padding-panel;
        spacing: Theme.gap-small;

        if root.title != "": Text {
            text: root.title;
            font-size: Theme.font-size-title;
            color: Theme.text;
            font-weight: 700;
        }

        @children
    }
}

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <color> text-color: Theme.text;
    in property <int> text-font-weight: 400;
    callback clicked;

    min-width: 96px;
    height: Theme.control-height;
    border-radius: Theme.radius-control;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.control-border;

    HorizontalLayout {
        padding-left: Theme.padding-panel;
        padding-right: Theme.padding-panel;
        alignment: center;
        spacing: root.icon.width > 0 ? Theme.gap-small : 0px;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            width: 16px;
            height: Theme.control-height;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                image-fit: contain;
                colorize: root.enabled ? root.text-color : Theme.text-muted;
            }
        }

        Text {
            text: root.text;
            color: root.enabled ? root.text-color : Theme.text-muted;
            font-size: Theme.font-size;
            font-weight: root.text-font-weight;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch-area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    states [
        hovered when touch-area.has-hover && root.enabled: {
            background: Theme.control-hover;
            border-color: Theme.text-muted;
        }
        pressed when touch-area.pressed && root.enabled: {
            background: #252525;
        }
        disabled when !root.enabled: {
            background: Theme.control;
            border-color: Theme.control-border;
        }
    ]

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
}

export component PrimaryButton inherits AppButton {
    background: Theme.accent;
    border-color: Theme.accent;
    text-color: Theme.on-accent;
    text-font-weight: 700;

    states [
        disabled when !root.enabled: {
            background: #2d2d2d;
            border-color: Theme.control-border;
        }
    ]
}

export component IconButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked;

    width: 30px;
    height: 30px;
    border-radius: Theme.radius-control;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.control-border;

    if root.icon.width > 0: Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        image-fit: contain;
        colorize: root.enabled ? Theme.text : Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.icon.width <= 0: Text {
        text: root.text;
        color: Theme.text;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch-area := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    states [
        disabled when !root.enabled: {
            background: Theme.control;
            border-color: Theme.control-border;
        }
    ]
}

export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> label: "";
    in property <string> placeholder: "";
    in property <string> suffix: "";
    in property <bool> error: false;
    callback edited(string);
    callback accepted(string);

    min-width: 100px;
    preferred-width: 100px;
    height: Theme.control-height;
    clip: true;

    HorizontalLayout {
        spacing: Theme.gap-small;

        if root.label != "": Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: Theme.font-size-small;
            vertical-alignment: center;
            width: 70px;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: Theme.control-height;
            border-radius: Theme.radius-control;
            background: Theme.control;
            border-width: 1px;
            border-color: root.error ? Theme.error : Theme.control-border;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: Theme.gap-small;

                TextInput {
                    text <=> root.text;
                    color: Theme.text;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    edited => {
                        root.edited(self.text);
                    }
                    accepted => {
                        root.accepted(self.text);
                    }
                }

                if root.suffix != "": Text {
                    text: root.suffix;
                    color: Theme.text-muted;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                }
            }

            if root.text == "": Text {
                text: root.placeholder;
                x: 10px;
                y: (parent.height - self.height) / 2;
                color: Theme.text-muted;
                font-size: Theme.font-size;
            }
        }
    }
}

export component Badge inherits Rectangle {
    in property <string> text;

    min-width: 34px;
    height: 22px;
    border-radius: 11px;
    background: Theme.accent;
    border-width: 1px;
    border-color: Theme.accent;
    clip: true;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;

        Text {
            text: root.text;
            color: Theme.on-accent;
            font-size: Theme.font-size-small;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

export component HintText inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-size-small;
    wrap: word-wrap;
}

export component ProgressBar inherits Rectangle {
    in property <float> value: 0;

    height: 6px;
    border-radius: 3px;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.control-border;

    Rectangle {
        width: parent.width * root.value;
        height: 100%;
        border-radius: 3px;
        background: Theme.accent;
    }
}

export component DialogPanel inherits Rectangle {
    border-radius: Theme.radius-panel;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.panel-border;
}
export component StatusBar inherits Rectangle {
    in property <string> message: "";
    in property <color> message-color: Theme.text-muted;
    in property <bool> show-progress: false;
    in property <float> progress: 0.0;

    min-height: 40px;
    background: Theme.bg;

    VerticalLayout {
        Rectangle {
            height: 1px;
            background: Theme.panel-border;
        }

        HorizontalLayout {
            padding-left: Theme.padding-window;
            padding-right: Theme.padding-window;
            padding-top: Theme.gap-small;
            padding-bottom: Theme.gap-small;
            spacing: Theme.gap-small;

            Text {
                text: root.message;
                color: root.message-color;
                font-size: Theme.font-size;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if root.show-progress: ProgressBar {
                width: 150px;
                value: root.progress;
            }

            @children
        }
    }
}
